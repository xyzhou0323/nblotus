<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>小红书一键排版 · 脑脑空间 NeuroBridge</title>
<style>
:root {
  --bg: #f5f5f5; --panel-bg: #fff; --border: #e0e0e0;
  --text: #333; --text2: #888; --primary: #4a7db5; --primary-h: #3a6da5;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system,BlinkMacSystemFont,"Microsoft YaHei",sans-serif; background:var(--bg); color:var(--text); height:100vh; overflow:hidden; }
.tool-app { display:flex; flex-direction:column; height:100vh; }
.tool-header {
  background:#fff; border-bottom:1px solid var(--border);
  padding:10px 20px; display:flex; align-items:center; gap:14px; flex-shrink:0;
}
.tool-header h1 { font-size:17px; font-weight:700; white-space:nowrap; }
.tool-header h1 span { color:var(--primary); }
.tool-header select { padding:5px 10px; border:1px solid #ddd; border-radius:4px; font-size:13px; }
.tool-header .sep { color:#ddd; }
.tool-header label { font-size:12px; color:var(--text2); display:flex; align-items:center; gap:4px; }
.tool-header input[type=color] { width:24px; height:24px; border:none; cursor:pointer; }
.tool-header .back-link { margin-left:auto; font-size:12px; color:var(--text2); text-decoration:none; white-space:nowrap; }
.tool-header .back-link:hover { color:var(--primary); }

.tool-main { display:flex; flex:1; gap:2px; overflow:hidden; background:var(--border); }

.panel { background:var(--panel-bg); display:flex; flex-direction:column; overflow:hidden; }
.panel-editor { flex:0 0 40%; }
.panel-preview { flex:1; }
.panel-header {
  padding:8px 14px; border-bottom:1px solid var(--border);
  font-size:13px; color:var(--text2); display:flex; align-items:center; justify-content:space-between;
  flex-shrink:0; background:#fafbfc;
}
.panel-header .label { font-weight:600; color:#555; }

#editor {
  width:100%; flex:1; border:none; outline:none; resize:none;
  padding:16px 20px; font-size:14px; line-height:1.8;
  font-family:"SF Mono","Fira Code","Consolas","Microsoft YaHei",monospace;
  color:#333; background:#fff;
}
#editor::placeholder { color:#ccc; font-size:13px; font-family:inherit; }
.toolbar { display:flex; gap:4px; padding:6px 14px; border-top:1px solid var(--border); flex-shrink:0; background:#fafbfc; flex-wrap:wrap; }
.toolbar button { padding:4px 10px; border:1px solid #ddd; border-radius:4px; background:#fff; cursor:pointer; font-size:11px; color:#666; transition:all 0.15s; white-space:nowrap; }
.toolbar button:hover { border-color:var(--primary); color:var(--primary); background:#f5f9ff; }
.toolbar .sep { width:1px; background:#ddd; margin:0 2px; }

.preview-wrap { flex:1; overflow:auto; display:flex; align-items:flex-start; justify-content:center; padding:20px; }
#previewCanvas { max-width:100%; max-height:70vh; box-shadow:0 4px 24px rgba(0,0,0,0.12); border-radius:4px; }

.page-nav { display:flex; align-items:center; justify-content:center; gap:12px; padding:8px; flex-shrink:0; border-top:1px solid var(--border); background:#fafbfc; }
.page-nav button {
  padding:4px 14px; border:1px solid #ddd; border-radius:4px; background:#fff; cursor:pointer; font-size:12px; color:#666;
}
.page-nav button:hover { border-color:var(--primary); color:var(--primary); }
.page-nav button:disabled { opacity:0.4; cursor:default; }
.page-nav .page-info { font-size:13px; color:var(--text2); min-width:80px; text-align:center; }

.tool-actions { padding:8px 20px; border-top:1px solid var(--border); display:flex; gap:10px; justify-content:center; flex-shrink:0; background:#fff; }
.btn { padding:9px 24px; border:none; border-radius:6px; cursor:pointer; font-size:14px; font-weight:600; transition:all 0.2s; }
.btn-success { background:#27ae60; color:#fff; }
.btn-success:hover { background:#219a52; }
.btn-secondary { background:#f0f2f5; color:#555; }
.btn-secondary:hover { background:#e4e6e9; }
.btn:disabled { opacity:0.5; cursor:not-allowed; }
.btn-ai { background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color:#fff; border:none; }
.btn-ai:hover { opacity:0.9; }
.btn-ai:disabled { opacity:0.5; cursor:not-allowed; }
.btn-warning { background:#f39c12; color:#fff; }
.btn-warning:hover { background:#e08e0b; }

.toast { position:fixed; top:20px; left:50%; transform:translateX(-50%); background:#333; color:#fff; padding:10px 24px; border-radius:20px; font-size:14px; z-index:1000; opacity:0; transition:opacity 0.3s; pointer-events:none; }
.toast.show { opacity:1; pointer-events:auto; }
.toast.success { background:#27ae60; }

/* Custom sidebar */
.custom-sidebar { background:var(--panel-bg); border-left:1px solid var(--border); flex-shrink:0; width:230px; display:flex; flex-direction:column; overflow:hidden; transition:width 0.25s; }
.custom-sidebar.closed { width:32px; }
.custom-panel-header { padding:8px 10px; border-bottom:1px solid var(--border); font-size:13px; color:var(--text2); cursor:pointer; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; background:#fafbfc; user-select:none; }
.custom-panel-header .arrow { transition:transform 0.25s; font-size:10px; }
.custom-sidebar.closed .arrow { transform:rotate(180deg); }
.custom-sidebar-scroll { flex:1; overflow-y:auto; padding:10px 12px; }
.custom-sidebar.closed .custom-sidebar-scroll { display:none; }
.custom-sidebar.closed .custom-panel-header span:first-child { display:none; }
.ctrl-group { margin-bottom:12px; }
.ctrl-group label { display:flex; justify-content:space-between; align-items:center; font-size:11px; color:var(--text2); margin-bottom:3px; }
.ctrl-group label .val { font-weight:600; color:var(--primary); font-size:11px; }
.ctrl-group input[type=range] { width:100%; accent-color:var(--primary); }
.ctrl-group select { width:100%; padding:4px 6px; border:1px solid #ddd; border-radius:4px; font-size:11px; }
.sidebar-section-title { font-size:10px; font-weight:700; color:#aaa; text-transform:uppercase; letter-spacing:1px; margin:14px 0 8px; padding-top:10px; border-top:1px solid var(--border); }
.sidebar-section-title:first-child { margin-top:0; border-top:none; padding-top:0; }

/* AI Panel */
.api-panel { display:none; position:fixed; top:50px; right:250px; background:#fff; border:1px solid var(--border); border-radius:8px; padding:14px 16px; z-index:500; box-shadow:0 8px 30px rgba(0,0,0,0.15); min-width:300px; }
.api-panel.show { display:block; }
.api-panel .api-row { display:flex; gap:8px; margin-bottom:8px; flex-wrap:wrap; align-items:center; }
.api-panel .api-row:last-child { margin-bottom:0; }
.api-panel select, .api-panel input { padding:5px 8px; border:1px solid #ddd; border-radius:4px; font-size:12px; }
.api-panel input[type=text], .api-panel input[type=password] { width:140px; }
.api-panel input[type=number] { width:70px; }
.api-panel .api-hint { font-size:10px; color:#aaa; margin-top:4px; }
.btn-api-toggle { width:28px; height:28px; border-radius:50%; border:1px solid #ddd; background:#fff; cursor:pointer; font-size:14px; display:flex; align-items:center; justify-content:center; transition:all 0.2s; }
.btn-api-toggle:hover, .btn-api-toggle.active { border-color:var(--primary); color:var(--primary); background:#f0f5fa; }
.btn-api-save { padding:4px 12px; border:none; border-radius:4px; background:var(--primary); color:#fff; cursor:pointer; font-size:12px; }
.btn-api-save:hover { background:var(--primary-h); }
.btn-ai-sm { padding:6px 14px; border:1px solid #27ae60; border-radius:4px; background:#fff; color:#27ae60; cursor:pointer; font-size:12px; font-weight:600; transition:all 0.2s; white-space:nowrap; }
.btn-ai-sm:hover { background:#27ae60; color:#fff; }
.btn-ai-sm:disabled { opacity:0.5; cursor:not-allowed; }

@media (max-width:768px) {
  .tool-main { flex-direction:column; }
  .panel-editor { flex:none; height:40%; }
  .tool-header { flex-wrap:wrap; gap:6px; padding:8px 10px; }
  .tool-header h1 { font-size:14px; }
  .custom-sidebar { width:180px; }
  .api-panel { right:10px; left:10px; min-width:auto; }
}
</style>
</head>
<body>
<div class="tool-app">

<div class="tool-header">
  <h1>小红书<span>一键排版</span></h1>
  <select id="templateSelect">
    <option value="interview">专业访谈</option>
    <option value="science">科普</option>
    <option value="translation">翻译</option>
    <option value="life">生活访谈</option>
    <option value="green">绿色</option>
    <option value="misc">待定</option>
  </select>
  <button class="btn-api-toggle" id="btnApiToggle" onclick="toggleApiPanel()" title="API 设置">⚙ API</button>
  <a href="/docs/resource/" class="back-link">← 返回资源</a>
  <input type="file" id="fileInput" accept=".md,.pdf,.docx" style="display:none" onchange="handleFileUpload(event)">
</div>

<div class="tool-main">
  <div class="panel panel-editor">
    <div class="panel-header"><span class="label">编辑区</span><span style="font-size:11px;color:#bbb">Markdown 语法</span></div>
    <textarea id="editor" placeholder="# 标题
（标题的第二行直接回车）
## 副标题（可选）
作者：XXX
排版：XXX
---
### 第一个小标题

段落文字。**粗体**标记关键词，*斜体*标记强调。

[高亮]核心观点用高亮标记[/高亮]

> 引用文字用 > 开头，会有左侧竖线装饰

### 第二个小标题

继续写更多内容..."></textarea>
    <div class="toolbar">
      <button onclick="applyFormat('bold')" title="加粗">B</button>
      <button onclick="applyFormat('italic')" title="斜体">I</button>
      <span class="sep"></span>
      <button onclick="applyFormat('h3')" title="小标题">H3</button>
      <button onclick="applyFormat('highlight')" title="高亮">★</button>
      <button onclick="applyFormat('quote')" title="引用">❝</button>
      <span class="sep"></span>
      <button onclick="applyFormat('divider')" title="分割线">—</button>
      <button onclick="applyFormat('image')" title="插入图片">🖼</button>
      <span class="sep"></span>
      <button onclick="applyFormat('hilightLine')" title="重点行">✦行</button>
    </div>
  </div>
  <div class="panel panel-preview">
    <div class="panel-header"><span class="label">预览</span><span style="font-size:11px;color:#bbb">1242×1660</span></div>
    <div class="preview-wrap"><canvas id="previewCanvas"></canvas></div>
    <div class="page-nav">
      <button id="btnPrev" onclick="prevPage()">← 上一页</button>
      <span class="page-info" id="pageInfo">封面</span>
      <button id="btnNext" onclick="nextPage()">下一页 →</button>
      <button id="btnDownloadPage" onclick="downloadCurrent()" disabled style="margin-left:8px">下载当前页</button>
    </div>
  </div>
  <div class="custom-sidebar open" id="customPanel">
    <div class="custom-panel-header" onclick="toggleCustomPanel()">
      <span>自定</span><span class="arrow">◀</span>
    </div>
    <div class="custom-sidebar-scroll">
      <div class="sidebar-section-title">封面</div>
      <div class="ctrl-group"><label>标题字号 <span class="val" id="valTitleSize">96</span></label><input type="range" id="titleSize" min="64" max="160" value="96" step="2"></div>
      <div class="ctrl-group"><label>副标题字号 <span class="val" id="valSubtitleSize">48</span></label><input type="range" id="subtitleSize" min="32" max="80" value="48" step="2"></div>
      <div class="ctrl-group"><label>作者/排版字号 <span class="val" id="valMetaSize">36</span></label><input type="range" id="metaSize" min="24" max="60" value="36" step="2"></div>
      <div class="sidebar-section-title">内页</div>
      <div class="ctrl-group"><label>小标题字号 <span class="val" id="valHeadingSize">60</span></label><input type="range" id="headingSize" min="40" max="88" value="60" step="2"></div>
      <div class="ctrl-group"><label>正文字号 <span class="val" id="valBodySize">42</span></label><input type="range" id="bodySize" min="28" max="64" value="42" step="2"></div>
      <div class="ctrl-group"><label>行距 <span class="val" id="valLineHeight">1.85</span></label><input type="range" id="lineHeight" min="1.5" max="2.5" value="1.85" step="0.05"></div>
      <div class="sidebar-section-title">标记样式</div>
      <div class="ctrl-group"><label>高亮样式</label><select id="highlightStyle"><option value="yellow">黄色底纹</option><option value="green">绿色底纹</option><option value="blue">蓝色底纹</option><option value="underline">细下划线</option><option value="boldline">粗下划线</option></select></div>
      <div class="sidebar-section-title">配色</div>
      <div class="ctrl-group"><label>标题字色</label><input type="color" id="colorHeading" value="#2d2d2d" style="width:100%;height:28px;border:1px solid #ddd;border-radius:4px;cursor:pointer"></div>
      <div class="ctrl-group"><label>正文字色</label><input type="color" id="colorBody" value="#2d2d2d" style="width:100%;height:28px;border:1px solid #ddd;border-radius:4px;cursor:pointer"></div>
      <div class="ctrl-group"><label>重点字色</label><input type="color" id="colorHighlight" value="#c0392b" style="width:100%;height:28px;border:1px solid #ddd;border-radius:4px;cursor:pointer"></div>
      <div class="ctrl-group"><label>下划线色</label><input type="color" id="colorUnderline" value="#4a7db5" style="width:100%;height:28px;border:1px solid #ddd;border-radius:4px;cursor:pointer"></div>
      <div id="pageAdjustSection" style="display:none">
        <div class="sidebar-section-title">当前页调整</div>
        <div class="ctrl-group">
          <label>正文字号 <span class="val" id="valPageFS">42</span></label>
          <div style="display:flex;gap:4px;align-items:center">
            <button onclick="adjustPageFont(-2)" style="flex:1;padding:4px 0;border:1px solid #ddd;border-radius:3px;background:#fff;cursor:pointer;font-size:13px;color:#555">−</button>
            <button onclick="adjustPageFont(+2)" style="flex:1;padding:4px 0;border:1px solid #ddd;border-radius:3px;background:#fff;cursor:pointer;font-size:13px;color:#555">+</button>
          </div>
        </div>
        <div class="ctrl-group">
          <label>行距 <span class="val" id="valPageLH">1.85</span></label>
          <div style="display:flex;gap:4px;align-items:center">
            <button onclick="adjustPageLH(-0.1)" style="flex:1;padding:4px 0;border:1px solid #ddd;border-radius:3px;background:#fff;cursor:pointer;font-size:13px;color:#555">−</button>
            <button onclick="adjustPageLH(+0.1)" style="flex:1;padding:4px 0;border:1px solid #ddd;border-radius:3px;background:#fff;cursor:pointer;font-size:13px;color:#555">+</button>
          </div>
        </div>
        <div style="margin-top:6px">
          <button onclick="resetPageSettings()" id="btnResetPage" style="width:100%;padding:4px 0;border:1px solid #e0c0c0;border-radius:4px;background:#fff;cursor:pointer;font-size:11px;color:#c0392b;display:none">重置本页 → 全局默认</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="tool-actions">
  <button class="btn btn-ai" onclick="aiFormat()" id="btnAiBottom">AI 智能排版</button>
  <button class="btn btn-success" id="btnExport" onclick="exportAll()">导出全部 PNG</button>
  <button class="btn btn-secondary" onclick="resetAll()">清空</button>
  <button class="btn btn-secondary" id="btnUpload2" onclick="document.getElementById('fileInput').click()">上传文件</button>
</div>

<div class="toast" id="toast"></div>

<div class="api-panel" id="apiPanel">
  <div class="api-row">
    <select id="apiProvider" onchange="onProviderChange()">
      <option value="custom">自定义</option>
      <option value="deepseek">DeepSeek</option>
      <option value="openai">OpenAI</option>
      <option value="anthropic">Anthropic</option>
      <option value="zhipu">智谱 GLM</option>
      <option value="qwen">通义千问</option>
      <option value="moonshot">Kimi</option>
    </select>
    <input type="password" id="apiKey" placeholder="API Key">
  </div>
  <div class="api-row">
    <input type="text" id="apiEndpoint" placeholder="Endpoint URL">
    <input type="text" id="apiModel" placeholder="Model">
  </div>
  <div class="api-row">
    <select id="apiFormat"><option value="openai">OpenAI 兼容</option><option value="anthropic">Anthropic</option></select>
    <input type="number" id="apiMaxTokens" placeholder="max_tokens" value="16384">
    <button class="btn-api-save" onclick="saveApiSettings()">保存</button>
  </div>
  <div class="api-hint">如遇 CORS 错误，请在 http://localhost 打开</div>
</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
<script>
// ===== Template definitions =====
const TEMPLATES = {
  interview:    { name: '专业访谈', cover: 'interview-cover.png',  inner: 'interview-inner.png' },
  science:      { name: '科普',     cover: 'science-cover.png',    inner: 'science-inner.png' },
  translation:  { name: '翻译',     cover: 'translation-cover.png',inner: 'translation-inner.png' },
  life:         { name: '生活访谈', cover: 'life-cover.png',       inner: 'life-inner.png' },
  green:        { name: '绿色',     cover: 'cover-green.png',      inner: 'inner-green.png' },
  misc:         { name: '待定',     cover: 'misc-cover.png',       inner: 'misc-inner.png' }
};

const CANVAS_W = 1242;
const CANVAS_H = 1660;

// Layout params (all in canvas pixels)
let COVER_TITLE_Y = 480;
let COVER_META_Y = 1400;
let INNER_HEADING_Y = 160;
let INNER_BODY_Y = 320;
const INNER_BODY_BOTTOM = 1600;
const INNER_MARGIN = 120;
const INNER_WIDTH = CANVAS_W - INNER_MARGIN * 2;

// Font sizes (customizable via sliders)
let FS_TITLE = 96;
let FS_SUBTITLE = 48;
let FS_META = 36;
let FS_HEADING = 60;
let FS_BODY = 42;
let LH_BODY = 1.85;
let highlightStyle = 'yellow';

let fontLoaded = false;
let pages = [];         // [{type:'cover'|'inner', canvas:HTMLCanvasElement, heading, paragraphs, fsBody, lhBody, fsHeading}]
let cachedCoverImg = null;
let cachedInnerImg = null;
let currentPage = 0;
let currentTemplate = 'interview';
let colorHeading = '#2d2d2d';
let colorBody = '#2d2d2d';
let colorHighlight = '#c0392b';
let colorUnderline = '#4a7db5';

// ===== Font loading =====
async function loadFont() {
  if (fontLoaded) return;
  const font = new FontFace('CangerJinkai', 'url(/fonts/仓耳今楷03-W04.ttf)');
  await font.load();
  document.fonts.add(font);
  // Also preload in a temp canvas to ensure it's available
  const c = document.createElement('canvas');
  c.width = 100; c.height = 100;
  const ctx = c.getContext('2d');
  ctx.font = '36px CangerJinkai';
  ctx.fillText('测', 0, 50);
  fontLoaded = true;
}

// ===== Inline tokenizer =====
function tokenize(text) {
  const tokens = [];
  const re = /(\*\*(.+?)\*\*|\*(.+?)\*|\[高亮\](.+?)\[\/高亮\])/g;
  let last = 0, m;
  while ((m = re.exec(text)) !== null) {
    if (m.index > last) tokens.push({ text: text.slice(last, m.index), bold: false, italic: false, highlight: false });
    if (m[2])      tokens.push({ text: m[2], bold: true,  italic: false, highlight: false });
    else if (m[3]) tokens.push({ text: m[3], bold: false, italic: true,  highlight: false });
    else if (m[4]) tokens.push({ text: m[4], bold: false, italic: false, highlight: true });
    last = re.lastIndex;
  }
  if (last < text.length) tokens.push({ text: text.slice(last), bold: false, italic: false, highlight: false });
  return tokens;
}

// ===== Rich text layout (char-level wrapping) =====
function layoutRichLines(ctx, tokens, maxWidth) {
  // Flatten tokens to styled chars
  const chars = [];
  for (const t of tokens) {
    for (const ch of t.text) {
      chars.push({ char: ch, bold: t.bold, italic: t.italic, highlight: t.highlight });
    }
  }

  // Wrap at char boundaries, measuring each char with its own font
  const NO_LINE_START = /^[，。！？：；》】」』〉）\.,!\?:;\)]$/;
  const lines = [];
  let curChars = [];
  let curW = 0;
  for (const c of chars) {
    ctx.font = c.bold ? `bold ${FS_BODY}px CangerJinkai` : `${FS_BODY}px CangerJinkai`;
    const cw = ctx.measureText(c.char).width;
    if (curW + cw > maxWidth && curChars.length > 0) {
      // Don't let punctuation start a new line alone
      if (NO_LINE_START.test(c.char) && curChars.length >= 2) {
        const last = curChars.pop();
        ctx.font = last.bold ? `bold ${FS_BODY}px CangerJinkai` : `${FS_BODY}px CangerJinkai`;
        curW -= ctx.measureText(last.char).width;
        lines.push(charsToTokens(curChars));
        curChars = [last, c];
        ctx.font = c.bold ? `bold ${FS_BODY}px CangerJinkai` : `${FS_BODY}px CangerJinkai`;
        curW = ctx.measureText(last.char).width + cw;
      } else {
        lines.push(charsToTokens(curChars));
        curChars = [c];
        curW = cw;
      }
    } else {
      curChars.push(c);
      curW += cw;
    }
  }
  if (curChars.length > 0) lines.push(charsToTokens(curChars));
  return lines;
}

function charsToTokens(chars) {
  if (chars.length === 0) return [];
  const tokens = [];
  let cur = { text: chars[0].char, bold: chars[0].bold, italic: chars[0].italic, highlight: chars[0].highlight };
  for (let i = 1; i < chars.length; i++) {
    const c = chars[i];
    if (c.bold === cur.bold && c.italic === cur.italic && c.highlight === cur.highlight) {
      cur.text += c.char;
    } else {
      tokens.push({ ...cur });
      cur = { text: c.char, bold: c.bold, italic: c.italic, highlight: c.highlight };
    }
  }
  tokens.push({ ...cur });
  return tokens;
}

function measureRichHeight(ctx, tokens, maxWidth, lineHeight) {
  return layoutRichLines(ctx, tokens, maxWidth).length * lineHeight;
}

// Draw a single line of rich tokens
function drawRichLine(ctx, lineTokens, x, y, baseFontSize, textColor) {
  let cx = x;
  for (const t of lineTokens) {
    let fontStr = `${baseFontSize}px CangerJinkai`;
    if (t.bold) fontStr = `bold ${baseFontSize}px CangerJinkai`;
    ctx.font = fontStr;
    const tw = ctx.measureText(t.text).width;

    if (t.highlight) {
      const fh = baseFontSize;
      const h = highlightStyle || 'yellow';
      if (h === 'underline') {
        ctx.fillStyle = 'rgba(255,180,30,0.7)';
        ctx.fillRect(cx - 1, y + fh * 1.05, tw + 2, Math.max(2, fh * 0.06));
      } else if (h === 'boldline') {
        // Match typeset: textDecorationThickness 0.5em, offset -0.15em, low opacity
        ctx.fillStyle = 'rgba(74,125,181,0.22)';
        ctx.fillRect(cx - 1, y + fh * 0.88, tw + 2, Math.round(fh * 0.45));
      } else {
        const colors = { yellow: 'rgba(255,220,80,0.4)', green: 'rgba(150,220,140,0.4)', blue: 'rgba(130,190,240,0.4)' };
        ctx.fillStyle = colors[h] || colors.yellow;
        ctx.fillRect(cx - 2, y - fh * 0.05, tw + 4, fh * 1.1);
      }
    }

    ctx.fillStyle = t.italic ? lightenColor(textColor) : textColor;
    ctx.fillText(t.text, cx, y);
    cx += tw;
  }
  return y + baseFontSize * LH_BODY;
}

function lightenColor(hex) {
  const r = parseInt(hex.slice(1,3), 16), g = parseInt(hex.slice(3,5), 16), b = parseInt(hex.slice(5,7), 16);
  const mix = (c) => Math.round(c + (180 - c) * 0.4).toString(16).padStart(2, '0');
  return '#' + mix(r) + mix(g) + mix(b);
}

// Simple char-level wrap for cover text (no inline formatting)
function wrapLines(ctx, text, maxWidth) {
  const NO_LINE_START = /^[，。！？：；》】」』〉）\.,!\?:;\)]$/;
  const lines = [];
  let current = '';
  for (const ch of text) {
    const test = current + ch;
    if (ctx.measureText(test).width > maxWidth && current.length > 0) {
      if (NO_LINE_START.test(ch) && current.length >= 2) {
        const last = current.slice(-1);
        lines.push(current.slice(0, -1));
        current = last + ch;
      } else {
        lines.push(current);
        current = ch;
      }
    } else { current = test; }
  }
  if (current) lines.push(current);
  return lines;
}

// ===== Drawing helpers =====
function drawCover(ctx, tpl, meta) {
  ctx.fillStyle = colorHeading;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'top';

  let endY = COVER_TITLE_Y;

  // Title — split by manual \n first, then auto-wrap each segment if too long
  if (meta.title) {
    ctx.font = `bold ${FS_TITLE}px CangerJinkai`;
    const manualLines = meta.title.split('\n');
    for (const seg of manualLines) {
      if (!seg.trim()) { endY += FS_TITLE * 0.6; continue; }
      const wrapped = wrapLines(ctx, seg.trim(), CANVAS_W - 160);
      for (const line of wrapped) {
        ctx.fillText(line, CANVAS_W / 2, endY);
        endY += FS_TITLE * 1.3;
      }
    }
  }

  // Subtitle
  if (meta.subtitle) {
    endY += FS_TITLE * 0.3; // gap after title
    ctx.font = `${FS_SUBTITLE}px CangerJinkai`;
    ctx.globalAlpha = 0.75;
    const subLines = wrapLines(ctx, meta.subtitle, CANVAS_W - 200);
    for (const line of subLines) {
      ctx.fillText(line, CANVAS_W / 2, endY);
      endY += FS_SUBTITLE * 1.4;
    }
    ctx.globalAlpha = 1;
  }

  // Author / Typesetter (bottom center, fixed position)
  ctx.textAlign = 'center';
  ctx.font = `${FS_META}px CangerJinkai`;
  ctx.fillStyle = colorBody;
  ctx.globalAlpha = 0.7;
  let my = COVER_META_Y;
  if (meta.author) { ctx.fillText(`作者：${meta.author}`, CANVAS_W / 2, my); my += FS_META * 1.6; }
  if (meta.typesetter) { ctx.fillText(`排版：${meta.typesetter}`, CANVAS_W / 2, my); }
  ctx.globalAlpha = 1;
}

function drawInnerPage(ctx, tpl, heading, paragraphs) {
  ctx.textAlign = 'left';
  ctx.textBaseline = 'top';

  // Heading
  if (heading) {
    ctx.font = `bold ${FS_HEADING}px CangerJinkai`;
    ctx.fillStyle = colorHeading;
    ctx.fillText(heading, INNER_MARGIN, INNER_HEADING_Y);
  }

  const lh = FS_BODY * LH_BODY;
  let y = heading ? INNER_BODY_Y : INNER_HEADING_Y;

  for (const para of paragraphs) {
    if (para.type === 'image') {
      const imgH = para._imgHeight || 400;
      if (y + imgH > INNER_BODY_BOTTOM) return false;
      if (para._img) {
        const imgW = para._imgWidth || INNER_WIDTH;
        const x = INNER_MARGIN + (INNER_WIDTH - imgW) / 2;
        ctx.drawImage(para._img, x, y, imgW, imgH);
      }
      y += imgH + lh * 0.4;
      continue;
    }

    const isBQ = para.type === 'blockquote';
    const textX = isBQ ? INNER_MARGIN + 36 : INNER_MARGIN;
    const w = isBQ ? INNER_WIDTH - 36 : INNER_WIDTH;

    const lines = layoutRichLines(ctx, para.tokens, w);
    for (const lineTokens of lines) {
      if (y + lh > INNER_BODY_BOTTOM) return false;

      if (isBQ) {
        ctx.fillStyle = textColor;
        ctx.globalAlpha = 0.25;
        ctx.fillRect(INNER_MARGIN + 6, y - FS_BODY * 0.75, 4, lh);
        ctx.globalAlpha = 1;
        ctx.fillStyle = textColor;
        ctx.globalAlpha = 0.8;
      }

      drawRichLine(ctx, lineTokens, textX, y, FS_BODY, textColor);
      if (isBQ) ctx.globalAlpha = 1;
      y += lh;
    }
    y += lh * 0.4;
  }
  return true;
}

// ===== Pagination =====
function parseEditor(text) {
  const lines = text.split('\n');
  const meta = { title: '', subtitle: '', author: '', typesetter: '' };
  let contentStart = -1;

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    if (line === '---') { contentStart = i + 1; break; }
    if (line.startsWith('# ') && !meta.title) { meta.title = line.replace(/^#\s+/, ''); }
    else if (line.startsWith('## ')) { meta.subtitle = line.replace(/^##\s+/, ''); }
    else if (line.startsWith('作者：')) { meta.author = line.replace(/^作者：/, ''); }
    else if (line.startsWith('排版：')) { meta.typesetter = line.replace(/^排版：/, ''); }
    else if (meta.title && !meta.subtitle && line && !line.startsWith('#')) {
      meta.title += '\n' + line;
    }
  }

  // Parse content sections
  const sections = [];
  let currentSection = { heading: null, paragraphs: [] };
  let pendingBQLines = [];

  function flushBQ() {
    if (pendingBQLines.length > 0) {
      const raw = pendingBQLines.join('\n');
      currentSection.paragraphs.push({ type: 'blockquote', raw, tokens: tokenize(raw) });
      pendingBQLines = [];
    }
  }

  function pushPara(text) {
    currentSection.paragraphs.push({ type: 'normal', raw: text, tokens: tokenize(text) });
  }

  const contentLines = contentStart >= 0 ? lines.slice(contentStart) : [];
  for (const line of contentLines) {
    const trimmed = line.trim();
    if (/^###\s+(.+)/.test(trimmed)) {
      flushBQ();
      if (currentSection.heading !== null || currentSection.paragraphs.length > 0) {
        sections.push(currentSection);
      }
      currentSection = { heading: trimmed.replace(/^###\s+/, ''), paragraphs: [] };
    } else if (/^!\[([^\]]*)\]\(([^)]+)\)\s*$/.test(trimmed)) {
      flushBQ();
      const m = trimmed.match(/^!\[([^\]]*)\]\(([^)]+)\)\s*$/);
      currentSection.paragraphs.push({ type: 'image', src: m[2], alt: m[1] });
    } else if (/^>\s*(.*)/.test(trimmed)) {
      pendingBQLines.push(trimmed.replace(/^>\s*/, ''));
    } else if (trimmed === '') {
      flushBQ();
    } else {
      flushBQ();
      pushPara(trimmed);
    }
  }
  flushBQ();
  if (currentSection.heading !== null || currentSection.paragraphs.length > 0) {
    sections.push(currentSection);
  }

  return { meta, sections };
}

async function buildPages() {
  await loadFont();
  const tpl = TEMPLATES[currentTemplate];
  const { meta, sections } = parseEditor(document.getElementById('editor').value);
  pages = [];

  // Load cover image
  const coverImg = await loadImage('/images/xhs/' + tpl.cover);
  // Load inner image
  const innerImg = await loadImage('/images/xhs/' + tpl.inner);
  cachedCoverImg = coverImg;
  cachedInnerImg = innerImg;

  // === Cover page ===
  const coverCanvas = document.createElement('canvas');
  coverCanvas.width = CANVAS_W;
  coverCanvas.height = CANVAS_H;
  const coverCtx = coverCanvas.getContext('2d');
  coverCtx.drawImage(coverImg, 0, 0, CANVAS_W, CANVAS_H);
  drawCover(coverCtx, tpl, meta);
  pages.push({ type: 'cover', canvas: coverCanvas });

  // === Inner pages ===
  const measureCanvas = document.createElement('canvas');
  measureCanvas.width = CANVAS_W;
  measureCanvas.height = CANVAS_H;
  const mCtx = measureCanvas.getContext('2d');

  // Preload all content images
  const MAX_IMG_HEIGHT = 600;
  for (const section of sections) {
    for (const para of section.paragraphs) {
      if (para.type === 'image') {
        try {
          const src = resolveImageSrc(para.src);
          const img = await loadImage(src);
          para._img = img;
          const scale = Math.min(1, INNER_WIDTH / img.naturalWidth);
          para._imgWidth = Math.round(img.naturalWidth * scale);
          para._imgHeight = Math.min(MAX_IMG_HEIGHT, Math.round(img.naturalHeight * scale));
        } catch(e) {
          para._img = null;
          para._imgHeight = 200;
          para._imgWidth = INNER_WIDTH;
        }
      }
    }
  }

  function measParaH(para) {
    if (para.type === 'image') return para._imgHeight || 200;
    const w = para.type === 'blockquote' ? INNER_WIDTH - 36 : INNER_WIDTH;
    return measureRichHeight(mCtx, para.tokens, w, lh);
  }

  const lh = FS_BODY * LH_BODY;
  const maxH = INNER_BODY_BOTTOM - INNER_BODY_Y;

  for (const section of sections) {
    let remainingParas = [...section.paragraphs];
    let firstPageOfSection = true;

    while (remainingParas.length > 0) {
      const innerCanvas = document.createElement('canvas');
      innerCanvas.width = CANVAS_W;
      innerCanvas.height = CANVAS_H;
      const innerCtx = innerCanvas.getContext('2d');
      innerCtx.drawImage(innerImg, 0, 0, CANVAS_W, CANVAS_H);

      const heading = firstPageOfSection ? section.heading : null;
      let availableH = maxH;

      const fittedParas = [];
      const overflowParas = [];
      let usedH = 0;
      let canFit = true;

      for (let i = 0; i < remainingParas.length; i++) {
        const para = remainingParas[i];
        const paraH = measParaH(para);
        const paraSpace = paraH + (i < remainingParas.length - 1 || fittedParas.length > 0 ? lh * 0.4 : 0);

        if (usedH + paraSpace <= availableH) {
          fittedParas.push(para);
          usedH += paraSpace;
        } else {
          if (i === 0 && usedH === 0 && para.type === 'image') {
            // Image doesn't fit even on empty page — force it in anyway
            fittedParas.push(para);
            overflowParas.push(...remainingParas.slice(i + 1));
          } else if (i === 0 && usedH === 0) {
            // Split text paragraph at sentence boundaries
            const sentences = para.raw.split(/(?<=[。！？])/);
            let partialRaw = '';
            let partialH = 0;
            let splitIdx = 0;
            const w = para.type === 'blockquote' ? INNER_WIDTH - 36 : INNER_WIDTH;
            for (let s = 0; s < sentences.length; s++) {
              const testRaw = partialRaw + sentences[s];
              const testTokens = tokenize(testRaw);
              const sh = measureRichHeight(mCtx, testTokens, w, lh);
              if (partialH + sh <= availableH) {
                partialRaw = testRaw;
                partialH = sh;
                splitIdx = s + 1;
              } else if (splitIdx > 0) {
                break;
              } else {
                partialRaw = testRaw;
                splitIdx = s + 1;
                break;
              }
            }
            fittedParas.push({ type: para.type, raw: partialRaw, tokens: tokenize(partialRaw) });
            const remainder = sentences.slice(splitIdx).join('');
            if (remainder.trim()) {
              overflowParas.push({ type: para.type, raw: remainder, tokens: tokenize(remainder) });
            }
            overflowParas.push(...remainingParas.slice(i + 1));
          } else if (fittedParas.length === 0 && i > 0) {
            overflowParas.push(...remainingParas.slice(i));
          } else {
            overflowParas.push(...remainingParas.slice(i));
          }
          canFit = false;
          break;
        }
      }

      if (canFit) { remainingParas = []; }
      else { remainingParas = overflowParas; }

      drawInnerPage(innerCtx, tpl, heading, fittedParas);
      pages.push({ type: 'inner', canvas: innerCanvas, heading, paragraphs: fittedParas });
      firstPageOfSection = false;
    }
  }

  // If no inner pages and no sections, still show one blank inner page as preview
  if (pages.length === 1 && sections.length === 0) {
    const innerCanvas = document.createElement('canvas');
    innerCanvas.width = CANVAS_W;
    innerCanvas.height = CANVAS_H;
    const innerCtx = innerCanvas.getContext('2d');
    innerCtx.drawImage(innerImg, 0, 0, CANVAS_W, CANVAS_H);
    pages.push({ type: 'inner', canvas: innerCanvas, heading: null, paragraphs: [] });
  }

  if (currentPage >= pages.length) currentPage = Math.max(0, pages.length - 1);
  updatePreview();
}

function loadImage(src) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => resolve(img);
    img.onerror = reject;
    img.src = src;
  });
}

// ===== Preview =====
function updatePreview() {
  const canvas = document.getElementById('previewCanvas');
  const info = document.getElementById('pageInfo');
  const btnPrev = document.getElementById('btnPrev');
  const btnNext = document.getElementById('btnNext');

  if (pages.length === 0) {
    canvas.style.display = 'none';
    info.textContent = '—';
    btnPrev.disabled = true; btnNext.disabled = true;
    return;
  }

  canvas.style.display = '';
  const page = pages[currentPage];
  const srcCanvas = page.canvas;

  // Scale to fit preview area
  const maxPreviewH = 500;
  const scale = Math.min(1, maxPreviewH / CANVAS_H);
  canvas.width = CANVAS_W * scale;
  canvas.height = CANVAS_H * scale;
  const ctx = canvas.getContext('2d');
  ctx.drawImage(srcCanvas, 0, 0, canvas.width, canvas.height);

  const typeLabel = page.type === 'cover' ? '封面' : (page.heading ? `内页 · ${page.heading.slice(0, 12)}` : '内页(续)');
  info.textContent = `${currentPage + 1} / ${pages.length}  ${typeLabel}`;
  btnPrev.disabled = currentPage === 0;
  btnNext.disabled = currentPage >= pages.length - 1;
  const btnDl = document.getElementById('btnDownloadPage');
  if (btnDl) btnDl.disabled = pages.length === 0;

  // Per-page font controls in sidebar
  const section = document.getElementById('pageAdjustSection');
  const btnReset = document.getElementById('btnResetPage');
  if (page.type === 'inner' && pages.length > 0) {
    if (section) section.style.display = '';
    document.getElementById('valPageFS').textContent = getPageFS();
    document.getElementById('valPageLH').textContent = getPageLH().toFixed(2);
    if (btnReset) btnReset.style.display = hasPageOverrides() ? '' : 'none';
  } else {
    if (section) section.style.display = 'none';
    if (btnReset) btnReset.style.display = 'none';
  }
}

function prevPage() { if (currentPage > 0) { currentPage--; updatePreview(); } }
function nextPage() { if (currentPage < pages.length - 1) { currentPage++; updatePreview(); } }

// ===== Per-page font overrides =====
function renderPage(i) {
  const page = pages[i];
  if (!page) return;

  if (page.type === 'cover') {
    const canvas = document.createElement('canvas');
    canvas.width = CANVAS_W; canvas.height = CANVAS_H;
    const ctx = canvas.getContext('2d');
    if (cachedCoverImg) ctx.drawImage(cachedCoverImg, 0, 0, CANVAS_W, CANVAS_H);
    const { meta } = parseEditor(document.getElementById('editor').value);
    drawCover(ctx, TEMPLATES[currentTemplate], meta);
    page.canvas = canvas;
    return;
  }

  const origFS = FS_BODY, origLH = LH_BODY, origFH = FS_HEADING;
  if (page.fsBody !== undefined) FS_BODY = page.fsBody;
  if (page.lhBody !== undefined) LH_BODY = page.lhBody;
  if (page.fsHeading !== undefined) FS_HEADING = page.fsHeading;

  const canvas = document.createElement('canvas');
  canvas.width = CANVAS_W; canvas.height = CANVAS_H;
  const ctx = canvas.getContext('2d');
  if (cachedInnerImg) ctx.drawImage(cachedInnerImg, 0, 0, CANVAS_W, CANVAS_H);
  drawInnerPage(ctx, TEMPLATES[currentTemplate], page.heading, page.paragraphs);
  page.canvas = canvas;

  FS_BODY = origFS; LH_BODY = origLH; FS_HEADING = origFH;
}

function getPageFS() {
  const p = pages[currentPage];
  return (p && p.fsBody !== undefined) ? p.fsBody : FS_BODY;
}
function getPageLH() {
  const p = pages[currentPage];
  return (p && p.lhBody !== undefined) ? p.lhBody : LH_BODY;
}
function hasPageOverrides() {
  const p = pages[currentPage];
  return p && (p.fsBody !== undefined || p.lhBody !== undefined || p.fsHeading !== undefined);
}

function adjustPageFont(delta) {
  if (pages.length === 0 || pages[currentPage].type === 'cover') return;
  const page = pages[currentPage];
  const cur = getPageFS();
  const next = Math.max(24, Math.min(80, cur + delta));
  if (next === FS_BODY) {
    delete page.fsBody;
  } else {
    page.fsBody = next;
  }
  renderPage(currentPage);
  updatePreview();
}

function adjustPageLH(delta) {
  if (pages.length === 0 || pages[currentPage].type === 'cover') return;
  const page = pages[currentPage];
  const cur = getPageLH();
  const next = Math.round((Math.max(1.2, Math.min(3.0, cur + delta))) * 100) / 100;
  if (Math.abs(next - LH_BODY) < 0.005) {
    delete page.lhBody;
  } else {
    page.lhBody = next;
  }
  renderPage(currentPage);
  updatePreview();
}

function resetPageSettings() {
  if (pages.length === 0) return;
  const page = pages[currentPage];
  delete page.fsBody;
  delete page.lhBody;
  delete page.fsHeading;
  renderPage(currentPage);
  updatePreview();
}

async function downloadCurrent() {
  if (pages.length === 0) return;
  const page = pages[currentPage];
  const blob = await canvasToBlob(page.canvas);
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const typeName = page.type === 'cover' ? '封面' : (page.heading ? page.heading.slice(0, 12) : '内页');
  a.download = `小红书排版_${typeName}_${currentPage + 1}.png`;
  a.href = url; a.click();
  URL.revokeObjectURL(url);
  showToast(`已下载第 ${currentPage + 1} 页`, 'success');
}

// ===== Export =====
async function exportAll() {
  if (pages.length === 0) { showToast('请先输入内容', ''); return; }
  const btn = document.getElementById('btnExport');
  const origText = btn.textContent;
  btn.textContent = '导出中...';
  btn.disabled = true;
  showToast('正在生成图片...', '');

  try {
    if (typeof JSZip === 'undefined') {
      await new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js';
        s.onload = resolve; s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    const zip = new JSZip();
    const tplName = currentTemplate;
    for (let i = 0; i < pages.length; i++) {
      const blob = await canvasToBlob(pages[i].canvas);
      const typeName = pages[i].type === 'cover' ? '封面' : `内页${i}`;
      const filename = `小红书_${TEMPLATES[tplName].name}_${String(i + 1).padStart(2, '0')}_${typeName}.png`;
      zip.file(filename, blob);
    }

    const zipBlob = await zip.generateAsync({ type: 'blob' });
    const url = URL.createObjectURL(zipBlob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `小红书排版_${TEMPLATES[tplName].name}_${new Date().toISOString().slice(0, 10)}.zip`;
    a.click();
    URL.revokeObjectURL(url);
    showToast(`已导出 ${pages.length} 张图片`, 'success');
  } catch (err) {
    console.error('Export error:', err);
    showToast('导出失败：' + (err.message || '未知错误'), '');
  } finally {
    btn.textContent = origText;
    btn.disabled = false;
  }
}

function canvasToBlob(canvas) {
  return new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
}

// ===== Debounced rebuild =====
function debounce(fn, delay) {
  let timer;
  return function(...args) { clearTimeout(timer); timer = setTimeout(() => fn.apply(this, args), delay); };
}

const rebuildPages = debounce(async () => {
  try { await buildPages(); } catch(e) { console.error('Build error:', e); }
}, 400);

// ===== Event handlers =====
document.getElementById('editor').addEventListener('input', rebuildPages);
document.getElementById('templateSelect').addEventListener('change', function() {
  currentTemplate = this.value;
  currentPage = 0;
  rebuildPages();
});
document.getElementById('textColor').addEventListener('input', function() {
  textColor = this.value;
  rebuildPages();
});

// ===== Toast =====
function showToast(msg, type) {
  const toast = document.getElementById('toast');
  toast.textContent = msg; toast.className = 'toast ' + (type||'') + ' show';
  clearTimeout(toast._timeout);
  toast._timeout = setTimeout(() => toast.classList.remove('show'), 2500);
}

function resetAll() {
  if (confirm('确定要清空所有内容吗？')) {
    document.getElementById('editor').value = '';
    pages = []; currentPage = 0;
    updatePreview();
    showToast('已清空', '');
  }
}

// ===== Editor toolbar =====
function applyFormat(type) {
  const editor = document.getElementById('editor');
  const inlineMap = {
    bold: ['**', '**', '加粗文字'], italic: ['*', '*', '斜体文字'],
    highlight: ['[高亮]', '[/高亮]', '重点文字']
  };
  const linePrefixes = { h3: '### ', quote: '> ' };

  if (type === 'hilightLine') {
    const text = editor.value;
    const pos = editor.selectionStart;
    const lineStart = text.lastIndexOf('\n', pos - 1) + 1;
    const lineEnd = text.indexOf('\n', pos);
    const end = lineEnd === -1 ? text.length : lineEnd;
    const currentLine = text.substring(lineStart, end);
    if (/^!!!\s/.test(currentLine)) {
      editor.value = text.substring(0, lineStart) + currentLine.replace(/^!!!\s/, '') + text.substring(end);
      editor.setSelectionRange(pos, Math.max(lineStart, pos - 4));
    } else {
      editor.value = text.substring(0, lineStart) + '!!! ' + currentLine + text.substring(end);
      editor.setSelectionRange(pos + 4, pos + 4);
    }
  } else if (inlineMap[type]) {
    const [before, after, placeholder] = inlineMap[type];
    const start = editor.selectionStart, end = editor.selectionEnd;
    const selected = editor.value.substring(start, end);
    const insertion = selected ? before + selected + after : before + placeholder + after;
    editor.value = editor.value.substring(0, start) + insertion + editor.value.substring(end);
    editor.focus();
    if (!selected) editor.setSelectionRange(start + before.length, start + before.length + placeholder.length);
    else editor.setSelectionRange(start, start + insertion.length);
  } else if (type === 'divider') {
    const start = editor.selectionStart;
    const ins = '\n---\n';
    editor.value = editor.value.substring(0, start) + ins + editor.value.substring(editor.selectionEnd);
    editor.focus(); editor.setSelectionRange(start + ins.length, start + ins.length);
  } else if (type === 'image') {
    const url = prompt('请输入图片 URL（或粘贴图片后手动替换）：');
    if (!url) return;
    const ins = `![image](${url})`;
    const start = editor.selectionStart;
    editor.value = editor.value.substring(0, start) + '\n' + ins + '\n' + editor.value.substring(editor.selectionEnd);
    editor.focus(); editor.setSelectionRange(start + ins.length + 2, start + ins.length + 2);
  } else if (linePrefixes[type]) {
    const prefix = linePrefixes[type];
    const text = editor.value;
    const pos = editor.selectionStart;
    const lineStart = text.lastIndexOf('\n', pos - 1) + 1;
    const lineEnd = text.indexOf('\n', pos);
    const end = lineEnd === -1 ? text.length : lineEnd;
    const currentLine = text.substring(lineStart, end);
    if (currentLine.startsWith(prefix)) {
      editor.value = text.substring(0, lineStart) + currentLine.substring(prefix.length) + text.substring(end);
      editor.setSelectionRange(pos, Math.max(lineStart, pos - prefix.length));
    } else {
      editor.value = text.substring(0, lineStart) + prefix + currentLine + text.substring(end);
      editor.setSelectionRange(pos + prefix.length, pos + prefix.length);
    }
  }
}

// ===== Custom panel =====
function toggleCustomPanel() {
  document.getElementById('customPanel').classList.toggle('closed');
}

const SLIDER_IDS = ['titleSize','subtitleSize','metaSize','headingSize','bodySize','lineHeight'];
const SLIDER_DEFAULTS = { titleSize:96, subtitleSize:48, metaSize:36, headingSize:60, bodySize:42, lineHeight:1.85 };

function loadCustomSettings() {
  try {
    const saved = JSON.parse(localStorage.getItem('xhsTypesetCustom') || '{}');
    for (const id of SLIDER_IDS) {
      const val = saved[id] !== undefined ? saved[id] : SLIDER_DEFAULTS[id];
      document.getElementById(id).value = val;
      document.getElementById('val' + id.charAt(0).toUpperCase() + id.slice(1)).textContent = val;
    }
    if (saved.highlightStyle) {
      highlightStyle = saved.highlightStyle;
      document.getElementById('highlightStyle').value = highlightStyle;
    }
    applySliders();
  } catch(e) {}
}

function saveCustomSettings() {
  const obj = {};
  for (const id of SLIDER_IDS) {
    obj[id] = parseFloat(document.getElementById(id).value);
  }
  obj.highlightStyle = highlightStyle;
  localStorage.setItem('xhsTypesetCustom', JSON.stringify(obj));
}

function applySliders() {
  FS_TITLE = parseInt(document.getElementById('titleSize').value);
  FS_SUBTITLE = parseInt(document.getElementById('subtitleSize').value);
  FS_META = parseInt(document.getElementById('metaSize').value);
  FS_HEADING = parseInt(document.getElementById('headingSize').value);
  FS_BODY = parseInt(document.getElementById('bodySize').value);
  LH_BODY = parseFloat(document.getElementById('lineHeight').value);
  highlightStyle = document.getElementById('highlightStyle').value;
  // Recalc Y positions based on font sizes
  COVER_TITLE_Y = 380 + FS_TITLE * 0.8;
  INNER_HEADING_Y = Math.round(FS_HEADING * 2.6);
  INNER_BODY_Y = INNER_HEADING_Y + FS_HEADING * 1.5 + FS_BODY * 0.8;
}

for (const id of SLIDER_IDS) {
  document.getElementById(id).addEventListener('input', function() {
    document.getElementById('val' + id.charAt(0).toUpperCase() + id.slice(1)).textContent = this.value;
    applySliders();
    saveCustomSettings();
    rebuildPages();
  });
}
document.getElementById('highlightStyle').addEventListener('change', function() {
  highlightStyle = this.value;
  saveCustomSettings();
  rebuildPages();
});

// ===== AI / API =====
const API_PROVIDERS = {
  deepseek:  { endpoint:'https://api.deepseek.com/v1/chat/completions', model:'deepseek-chat', format:'openai' },
  openai:    { endpoint:'https://api.openai.com/v1/chat/completions',  model:'gpt-4o', format:'openai' },
  anthropic: { endpoint:'https://api.anthropic.com/v1/messages',       model:'claude-sonnet-4-20250514', format:'anthropic' },
  zhipu:     { endpoint:'https://open.bigmodel.cn/api/paas/v4/chat/completions', model:'glm-4', format:'openai' },
  qwen:      { endpoint:'https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions', model:'qwen-plus', format:'openai' },
  moonshot:  { endpoint:'https://api.moonshot.cn/v1/chat/completions', model:'moonshot-v1-8k', format:'openai' }
};

function onProviderChange() {
  const prov = document.getElementById('apiProvider').value;
  if (API_PROVIDERS[prov]) {
    document.getElementById('apiEndpoint').value = API_PROVIDERS[prov].endpoint;
    document.getElementById('apiModel').value = API_PROVIDERS[prov].model;
    document.getElementById('apiFormat').value = API_PROVIDERS[prov].format;
  }
}

function toggleApiPanel() {
  document.getElementById('apiPanel').classList.toggle('show');
  document.getElementById('btnApiToggle').classList.toggle('active');
}

function saveApiSettings() {
  const s = {
    provider: document.getElementById('apiProvider').value,
    key: document.getElementById('apiKey').value,
    endpoint: document.getElementById('apiEndpoint').value,
    model: document.getElementById('apiModel').value,
    format: document.getElementById('apiFormat').value,
    maxTokens: document.getElementById('apiMaxTokens').value
  };
  localStorage.setItem('xhsTypesetApi', JSON.stringify(s));
  showToast('API 设置已保存', 'success');
}

function loadApiSettings() {
  try {
    const s = JSON.parse(localStorage.getItem('xhsTypesetApi') || '{}');
    if (s.provider) document.getElementById('apiProvider').value = s.provider;
    if (s.key) document.getElementById('apiKey').value = s.key;
    if (s.endpoint) document.getElementById('apiEndpoint').value = s.endpoint;
    if (s.model) document.getElementById('apiModel').value = s.model;
    if (s.format) document.getElementById('apiFormat').value = s.format;
    if (s.maxTokens) document.getElementById('apiMaxTokens').value = s.maxTokens;
  } catch(e) {}
}

async function aiFormat() {
  const s = JSON.parse(localStorage.getItem('xhsTypesetApi') || '{}');
  if (!s.key) { showToast('请先设置 API Key', ''); return; }
  const editor = document.getElementById('editor');
  const text = editor.value.trim();
  if (!text) { showToast('请先输入内容', ''); return; }
  // 剥离图片引用，避免 AI 修改 paste ID
  const imageMap = new Map();
  const strippedText = text.replace(/!\[([^\]]*)\]\((paste:\d+)\)/g, (match) => {
    const id = '[IMG_' + imageMap.size + ']';
    imageMap.set(id, match);
    return id;
  });

  const btn = document.getElementById('btnAI');
  const btn2 = document.getElementById('btnAiBottom');
  const origText = btn.textContent;
  btn.textContent = 'AI 排版中...'; btn.disabled = true;
  if (btn2) { btn2.textContent = 'AI 排版中...'; btn2.disabled = true; }

  const systemPrompt = `你是一个专业的小红书图文排版助手。请将用户提供的文本格式化为以下 Markdown 结构：

# 标题（提炼简洁有力的标题，30字以内；如需手动换行，将第二行内容单独成行放在标题下方）
## 副标题（可选，补充说明）
作者：XXX（保留原文作者信息）
排版：XXX（保留原文排版信息）
---
### 第一个小标题
段落内容...

### 第二个小标题
段落内容...

可用格式标记：
- **粗体** 标记重要概念和关键词
- *斜体* 标记强调或书名
- [高亮]文字[/高亮] 标记核心观点
- > 引用 标记引文或金句

规则：
1. 保留所有原始内容，不要删减或总结
2. 自动将长段落合理拆分为多个段落（每段3-5句话为宜）
3. 为内容生成合适的 ### 小标题，一般3-6个
4. **必须**标注重点：核心概念、专业术语、人名、数据用 **粗体** 标记
5. **必须**标注金句：每个 section 至少 1 句核心观点用 [高亮]...[/高亮] 标记
6. 引用、名言、他人观点用 > 引用格式
7. 不要修改原文意思
8. [IMG_N] 是图片占位标记，必须原样保留不修改不删除
9. 如果图片标记下方有说明文字，将其放在图片下一行
10. 只输出格式化后的 Markdown，不要输出任何解释说明`;

  try {
    let result;
    if (s.format === 'anthropic') {
      result = await callAnthropicAPI(s, systemPrompt, strippedText);
    } else {
      result = await callOpenAIAPI(s, systemPrompt, strippedText);
    }
    for (const [id, original] of imageMap) {
      result = result.replace(id, original);
    }
    editor.value = result;
    showToast('AI 排版完成', 'success');
    rebuildPages();
  } catch(err) {
    console.error('AI error:', err);
    showToast('AI 排版失败：' + (err.message || '未知错误'), '');
  } finally {
    btn.textContent = origText; btn.disabled = false;
    if (btn2) { btn2.textContent = 'AI 智能排版'; btn2.disabled = false; }
  }
}

async function callOpenAIAPI(s, systemPrompt, userText) {
  const resp = await fetch(s.endpoint, {
    method: 'POST',
    headers: { 'Content-Type':'application/json', 'Authorization':'Bearer ' + s.key },
    body: JSON.stringify({
      model: s.model,
      messages: [{role:'system',content:systemPrompt},{role:'user',content:userText}],
      temperature: 0.3,
      max_tokens: parseInt(s.maxTokens) || 16384
    })
  });
  if (!resp.ok) {
    if (resp.status === 401 || resp.status === 403) throw new Error('API Key 无效或无权限');
    if (resp.status === 404) throw new Error('Endpoint 或 Model 未找到');
    throw new Error('HTTP ' + resp.status);
  }
  const data = await resp.json();
  return data.choices[0].message.content;
}

async function callAnthropicAPI(s, systemPrompt, userText) {
  const resp = await fetch(s.endpoint, {
    method: 'POST',
    headers: { 'Content-Type':'application/json', 'x-api-key':s.key, 'anthropic-version':'2023-06-01' },
    body: JSON.stringify({
      model: s.model,
      max_tokens: parseInt(s.maxTokens) || 16384,
      system: systemPrompt,
      messages: [{role:'user',content:userText}]
    })
  });
  if (!resp.ok) {
    if (resp.status === 401 || resp.status === 403) throw new Error('API Key 无效或无权限');
    if (resp.status === 404) throw new Error('Endpoint 或 Model 未找到');
    throw new Error('HTTP ' + resp.status);
  }
  const data = await resp.json();
  return data.content[0].text;
}

// ===== Image paste =====
const pastedImages = {};
let pasteImageId = 0;

document.getElementById('editor').addEventListener('paste', (e) => {
  const items = e.clipboardData?.items;
  if (!items) return;
  for (const item of items) {
    if (item.type.startsWith('image/')) {
      e.preventDefault();
      const blob = item.getAsFile();
      const id = 'paste:' + (++pasteImageId);
      pastedImages[id] = URL.createObjectURL(blob);
      const md = `![image](${id})`;
      const editor = document.getElementById('editor');
      const start = editor.selectionStart;
      editor.value = editor.value.substring(0, start) + '\n' + md + '\n' + editor.value.substring(editor.selectionEnd);
      editor.focus(); editor.setSelectionRange(start + md.length + 2, start + md.length + 2);
      rebuildPages();
      return;
    }
  }
});

function resolveImageSrc(src) {
  return pastedImages[src] || src;
}

// ===== File upload =====
function stripMarkdownMeta(raw) {
  let text = raw;
  if (/^---\s*[\r\n]/.test(text)) {
    const end = text.indexOf('\n---', 4);
    if (end !== -1) text = text.slice(end + 5).trimStart();
  }
  return text.trim();
}

async function extractDocx(arrayBuffer) {
  if (!window.mammoth) {
    await new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js';
      s.onload = resolve; s.onerror = reject;
      document.head.appendChild(s);
    });
  }
  const result = await mammoth.convertToMarkdown({ arrayBuffer });
  let text = result.value;
  // Convert base64 images to blob URLs (direct decode, no fetch for large data URIs)
  const dataUriRegex = /!\[([^\]]*)\]\((data:image\/[^)]+)\)/g;
  text = text.replace(dataUriRegex, (match, alt, dataUri) => {
    const id = 'paste:' + (++pasteImageId);
    try {
      const parts = dataUri.split(',');
      const mime = (parts[0].match(/:(.*?);/) || ['', 'image/png'])[1];
      const binary = atob(parts[1]);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      const blob = new Blob([bytes], { type: mime });
      URL.revokeObjectURL(pastedImages[id]);
      pastedImages[id] = URL.createObjectURL(blob);
    } catch(e) { pastedImages[id] = dataUri; }
    return '![' + alt + '](' + id + ')';
  });
  return text;
}

async function extractPdf(arrayBuffer) {
  if (!window.pdfjsLib) {
    const urls = ['https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js', 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js'];
    let loaded = false;
    for (const url of urls) {
      try {
        await new Promise((resolve, reject) => { const s = document.createElement('script'); s.src = url; s.onload = resolve; s.onerror = reject; document.head.appendChild(s); });
        loaded = true; break;
      } catch (e) {}
    }
    if (!loaded) throw new Error('PDF.js 库加载失败');
    pdfjsLib.GlobalWorkerOptions.workerSrc = urls[0].replace('pdf.min.js', 'pdf.worker.min.js');
  }
  const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
  const pages = [];
  for (let i = 1; i <= pdf.numPages; i++) {
    const page = await pdf.getPage(i);
    const content = await page.getTextContent();
    pages.push(content.items.map(it => it.str).join(' '));
  }
  return pages.join('\n\n');
}

async function handleFileUpload(event) {
  const file = event.target.files[0];
  if (!file) return;
  const btn = document.getElementById('btnUpload');
  const origText = btn.textContent;
  btn.textContent = '上传中...';
  btn.disabled = true;
  showToast('正在解析文件...', '');
  try {
    const ext = file.name.split('.').pop().toLowerCase();
    const arrayBuffer = await file.arrayBuffer();
    let text = '';
    if (ext === 'md') text = stripMarkdownMeta(new TextDecoder().decode(arrayBuffer));
    else if (ext === 'docx') text = stripMarkdownMeta(await extractDocx(arrayBuffer));
    else if (ext === 'pdf') text = await extractPdf(arrayBuffer);
    else { showToast('不支持的文件格式：.' + ext, ''); return; }
    document.getElementById('editor').value = text;
    rebuildPages();
    showToast('已导入：' + file.name, 'success');
  } catch (err) {
    console.error('Upload error:', err);
    showToast('文件解析失败：' + (err.message || '请检查文件是否损坏'), '');
  } finally {
    btn.textContent = origText;
    btn.disabled = false;
    event.target.value = '';
  }
}

// ===== Sample text =====
const sampleText = `# 小红书排版工具
使用说明

## 脑脑空间 · 一键图文排版

作者：XyZ
排版：脑脑空间
---
### 工具简介

本工具为**小红书图文自动排版**工具，基于 Canvas 渲染，使用仓耳今楷字体，输出 3：4 竖版 PNG 图片。支持**多页自动分页**、**多页打包下载**为 ZIP 压缩包。

编辑区使用 Markdown 语法。修改内容后右侧实时预览，切换底图模板即可更改配色风格。

### 底图模板

工具内置 [高亮]6 套配色底图[/高亮]，每套含封面和内页各一张：

- 专业访谈 —— 深色底图，适合严肃访谈内容
- 科普 —— 浅色底图，适合知识科普类内容
- 翻译 —— 柔和底图，适合译文发布
- 生活访谈 —— 暖色底图，适合生活类访谈
- 绿色 —— 自然底色，通用型内容
- 待定 —— 简约灰调，灵活适配

通过顶部下拉菜单可切换模板，预览即时生效。

### 排版格式

封面由 **# 标题**（支持手动换行）、**## 副标题**、**作者**和**排版人**组成，所有文字居中对齐。

内页由 **### 小标题** 引领各章节。正文段落自动分页，[高亮]同段内容不会跨页[/高亮]。超长段落从句子结尾处断页，保持阅读连贯。

正文支持以下格式标记：**粗体**强调关键词、*斜体*标记特殊文本、[高亮]高亮标记[/高亮]突出核心观点，以及 > 引用格式。

### 自定义与 AI

右侧自定义面板可调节标题字号、正文字号、行距，以及高亮样式（底纹/下划线）。

点击 AI 排版按钮，可由大语言模型自动识别内容结构，生成标题、拆分段落、标注重点。支持 DeepSeek、OpenAI、Anthropic、智谱、通义千问、Kimi 等 API。

### 导出

点击 [高亮]导出全部 PNG[/高亮] 按钮，将所有页面打包为 ZIP 文件下载，每张图片尺寸为 1242 × 1660 像素。

支持上传 MD / DOCX / PDF 文件直接导入内容，也可在编辑区粘贴图片。`;

document.getElementById('editor').value = sampleText;

// ===== Init =====
async function init() {
  loadApiSettings();
  loadCustomSettings();
  applySliders();
  await loadFont();
  await buildPages();
  updatePreview();
}
init();
</script>

</body>
</html>
